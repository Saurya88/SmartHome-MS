@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()

title C4 Level 2 - SmartHome Microservices Container Diagram

Person(homeowner, "SmartHome User", "Admin, member, or guest who manages devices, users, permissions, and scene orchestration.")

System_Boundary(smarthome, "SmartHome System") {
    Container(api_gateway, "API Gateway", "Java, Spring Boot", "Exposes the public REST API on port 8080, returns HATEOAS links, and routes requests to all downstream services.")

    Container(scene_orchestrator_service, "Scene Orchestrator Service", "Java, Spring Boot", "Implements the core scene orchestration aggregate, validates users and devices, persists orchestration state, and coordinates downstream scene creation and updates.")
    Container(automation_service, "Automation Service", "Java, Spring Boot", "Manages low-level scenes, trigger rules, scene actions, and activation rules.")
    Container(device_service, "Device Service", "Java, Spring Boot", "Manages registered smart devices, status, firmware version, capabilities, and connectivity metadata.")
    Container(user_permissions_service, "User Permissions Service", "Java, Spring Boot", "Manages users, account status, roles, and device-level permissions.")

    ContainerDb(scene_orchestrator_db, "Scene Orchestrator DB", "MySQL", "Stores the persisted scene orchestration aggregate.")
    ContainerDb(automation_db, "Automation DB", "MySQL", "Stores scenes, scene actions, and trigger rules.")
    ContainerDb(device_db, "Device DB", "PostgreSQL", "Stores device registry data and capabilities.")
    ContainerDb(user_permissions_db, "User Permissions DB", "MySQL", "Stores users and device access permissions.")
}

System_Ext(smart_devices, "Smart Devices", "Physical cameras, lights, thermostats, locks, and sensors.")

Rel(homeowner, api_gateway, "Uses", "HTTPS/JSON")

Rel(api_gateway, scene_orchestrator_service, "Routes scene orchestration requests to", "HTTP/JSON")
Rel(api_gateway, automation_service, "Routes low-level automation requests to", "HTTP/JSON")
Rel(api_gateway, device_service, "Routes device requests to", "HTTP/JSON")
Rel(api_gateway, user_permissions_service, "Routes user and permission requests to", "HTTP/JSON")

Rel(scene_orchestrator_service, scene_orchestrator_db, "Reads from and writes to", "Spring Data JPA/JDBC")
Rel(scene_orchestrator_service, automation_service, "Creates and updates downstream scenes", "HTTP/JSON")
Rel(scene_orchestrator_service, device_service, "Validates device status and firmwareVersion", "HTTP/JSON")
Rel(scene_orchestrator_service, user_permissions_service, "Validates owner permissions", "HTTP/JSON")

Rel(automation_service, automation_db, "Reads from and writes to", "Spring Data JPA/JDBC")
Rel(device_service, device_db, "Reads from and writes to", "Spring Data JPA/JDBC")
Rel(user_permissions_service, user_permissions_db, "Reads from and writes to", "Spring Data JPA/JDBC")

Rel(device_service, smart_devices, "Represents and tracks", "Device registry data")
Rel(automation_service, smart_devices, "Targets through orchestrated device actions", "Device commands/events")

@enduml
