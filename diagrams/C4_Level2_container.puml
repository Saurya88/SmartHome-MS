@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()

title C4 Level 2 - SmartHome Microservices Container Diagram

Person(homeowner, "SmartHome User", "Admin, member, or guest who manages devices, users, permissions, and automation.")

System_Boundary(smarthome, "SmartHome System") {
    Container(api_gateway, "API Gateway", "Java, Spring Boot", "Exposes the public REST API on port 8080, routes requests to domain services, returns DTOs, HATEOAS links, and gateway error responses.")

    Container(user_permissions_service, "User Permissions Service", "Java, Spring Boot", "Manages users, roles, account status, and device-specific permissions.")
    Container(device_service, "Device Service", "Java, Spring Boot", "Manages registered smart devices, capabilities, status, firmware version, and connectivity details.")
    Container(automation_service, "Automation Service", "Java, Spring Boot", "Manages scenes, device actions, trigger rules, schedules, and scene activation.")

    ContainerDb(user_permissions_db, "User Permissions DB", "MySQL", "Stores users and device access permissions.")
    ContainerDb(device_db, "Device DB", "PostgreSQL", "Stores device registry data and device capabilities.")
    ContainerDb(automation_db, "Automation DB", "MySQL", "Stores scenes, scene actions, and trigger rules.")
}

System_Ext(smart_devices, "Smart Devices", "Physical cameras, lights, thermostats, locks, and sensors.")

Rel(homeowner, api_gateway, "Uses", "HTTPS/JSON")

Rel(api_gateway, user_permissions_service, "Routes user and permission requests to", "HTTP/JSON")
Rel(api_gateway, device_service, "Routes device requests to", "HTTP/JSON")
Rel(api_gateway, automation_service, "Routes scene and trigger rule requests to", "HTTP/JSON")

Rel(user_permissions_service, user_permissions_db, "Reads from and writes to", "Spring Data JPA/JDBC")
Rel(device_service, device_db, "Reads from and writes to", "Spring Data JPA/JDBC")
Rel(automation_service, automation_db, "Reads from and writes to", "Spring Data JPA/JDBC")

Rel(device_service, smart_devices, "Represents and tracks", "Device registry data")
Rel(automation_service, device_service, "References devices when defining actions", "Device IDs")

@enduml
