@startuml
title Smart Home Management Platform - DDD Domain Model

left to right direction

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

skinparam package {
  BorderColor #555555
  FontStyle bold
}

skinparam class {
  BorderColor #666666
  BackgroundColor #f8f8f8
}

legend right
  <b>DDD Legend</b>
  <<Aggregate Root>> Aggregate Root
  <<Entity>> Entity
  <<Value Object>> Value Object
  <<Repository>> Repository
  <<Domain Service>> Domain/Application Service
  <<Domain Client>> Cross-context client / ACL
  <<Interface Layer>> API gateway / routing layer
  --> Reference by ID or dependency
  *-- Owned inside aggregate
  o-- Associated collection
  Red context: Core subdomain
  Orange context: Orchestration/process manager
  Blue/Green contexts: Supporting subdomains
endlegend

package "API Gateway (Interface Layer - no domain aggregate)" #eeeeee {
  class ApiGateway <<Interface Layer>> {
    routeRequests()
    adaptGatewayDTOs()
    delegateToServices()
  }
}

package "Automation Routine Management (CORE)" #ffd6d6 {
  package "Scene Aggregate" {
    class Scene <<Aggregate Root>> {
      sceneId: UUID
      name: String
      status: SceneStatus
      createdAt: LocalDateTime
      deviceActions: List<DeviceAction>
      triggerRules: List<TriggerRule>
      addDeviceAction(action)
      addTriggerRule(rule)
      activate()
    }

    class DeviceAction <<Value Object>> {
      deviceId: UUID
      actionType: String
      parameters: String
    }

    enum SceneStatus {
      ACTIVE
      INACTIVE
      SCHEDULED
    }
  }

  package "Trigger Rule Aggregate" {
    class TriggerRule <<Aggregate Root>> {
      triggerId: String
      triggerType: TriggerType
      conditionExpression: String
      enabled: Boolean
      condition: Condition
      schedule: Schedule
      triggerValue: String
    }

    class Condition <<Value Object>> {
      attribute: String
      operator: String
      conditionValue: String
    }

    class Schedule <<Value Object>> {
      startTime: LocalDateTime
      endTime: LocalDateTime
      recurrencePattern: String
    }

    enum TriggerType {
      TIME_BASED
      SENSOR_EVENT
      MANUAL
    }
  }

  interface SceneRepository <<Repository>> {
    findById(UUID)
    findAll()
    save(Scene)
    deleteById(UUID)
  }

  interface TriggerRuleRepository <<Repository>> {
    findById(String)
    findAll()
    save(TriggerRule)
    deleteById(String)
  }

  class SceneService <<Domain Service>> {
    createScene(name)
    updateScene(sceneId, request)
    addDeviceActions(sceneId, actions)
    addTriggerRules(sceneId, rules)
    replaceDeviceActions(sceneId, actions)
    replaceTriggerRules(sceneId, rules)
    activateScene(sceneId)
    getAllScenes()
    deleteScene(sceneId)
  }

  class TriggerRuleService <<Domain Service>> {
    getAllTriggerRules()
    getTriggerRuleById(id)
    saveTriggerRule(triggerRule)
    deleteTriggerRuleById(id)
  }

  Scene *-- "0..*" DeviceAction
  Scene o-- "0..*" TriggerRule : triggerRules
  Scene --> SceneStatus
  TriggerRule *-- Condition
  TriggerRule *-- Schedule
  TriggerRule --> TriggerType
  SceneRepository ..> Scene
  TriggerRuleRepository ..> TriggerRule
  SceneService ..> SceneRepository
  TriggerRuleService ..> TriggerRuleRepository
}

package "Scene Orchestration (Process Manager)" #ffe7c2 {
  package "Scene Orchestration Aggregate" {
    class SceneOrchestration <<Aggregate Root>> {
      orchestrationId: UUID
      ownerUserId: UUID
      automationSceneId: UUID
      name: String
      status: String
      createdAt: LocalDateTime
      deviceActions: List<ManagedDeviceAction>
      triggerRules: List<ManagedTriggerRule>
    }

    class ManagedDeviceAction <<Value Object>> {
      deviceId: UUID
      actionType: String
      parameters: String
    }

    class ManagedTriggerRule <<Value Object>> {
      triggerId: String
      triggerType: String
      conditionExpression: String
      enabled: Boolean
      triggerValue: String
    }
  }

  interface SceneOrchestrationRepository <<Repository>> {
    findById(UUID)
    findAll()
    save(SceneOrchestration)
    deleteById(UUID)
  }

  class SceneOrchestrationService <<Domain Service>> {
    getAllSceneOrchestrations()
    getSceneOrchestrationById(orchestrationId)
    createSceneOrchestration(request)
    updateSceneOrchestration(orchestrationId, request)
    deleteSceneOrchestration(orchestrationId)
    validateInvariant(request)
  }

  class AutomationServiceClient <<Domain Client>> {
    createScene(request)
    updateScene(sceneId, request)
    addDeviceActions(sceneId, actions)
    addTriggerRules(sceneId, rules)
    replaceDeviceActions(sceneId, actions)
    replaceTriggerRules(sceneId, rules)
    activateScene(sceneId)
    deleteScene(sceneId)
  }

  class DeviceServiceClient <<Domain Client>> {
    getDeviceById(deviceId)
  }

  class UserServiceClient <<Domain Client>> {
    getUserById(userId)
  }

  SceneOrchestration *-- "1..*" ManagedDeviceAction
  SceneOrchestration *-- "1..*" ManagedTriggerRule
  SceneOrchestrationRepository ..> SceneOrchestration
  SceneOrchestrationService ..> SceneOrchestrationRepository
  SceneOrchestrationService ..> AutomationServiceClient
  SceneOrchestrationService ..> DeviceServiceClient
  SceneOrchestrationService ..> UserServiceClient
}

package "Device Registry (Supporting)" #dcecff {
  package "Device Aggregate" {
    class Device <<Aggregate Root>> {
      deviceId: UUID
      deviceName: String
      deviceType: DeviceType
      status: DeviceStatus
      firmwareVersion: String
      registeredAt: LocalDateTime
      capabilities: List<String>
      connectivityType: String
    }

    enum DeviceType {
      LIGHT
      THERMOSTAT
      SENSOR
      CAMERA
      LOCK
    }

    enum DeviceStatus {
      ONLINE
      OFFLINE
      MAINTENANCE
    }
  }

  package "Implemented Device Value Objects" {
    class DeviceCapabilities <<Value Object>> {
      capabilityType: String
      supportedActions: List<String>
      unit: String
    }

    class NetworkInfo <<Value Object>> {
      ipAddress: String
      macAddress: String
      connectivityType: ConnectivityType
    }

    class SensorData <<Value Object>> {
      timestamp: LocalDateTime
      value: String
      unit: String
    }

    class MaintenanceRecord <<Value Object>> {
      maintenanceDate: LocalDateTime
      performedBy: String
      notes: String
    }

    enum ConnectivityType {
      WIFI
      BLUETOOTH
      ETHERNET
    }
  }

  interface DeviceRepository <<Repository>> {
    findById(UUID)
    findAll()
    existsByDeviceName(deviceName)
    save(Device)
    deleteById(UUID)
  }

  class DeviceService <<Domain Service>> {
    getAllDevices()
    getDeviceById(deviceId)
    createDevice(device)
    updateDevice(deviceId, device)
    deleteDevice(deviceId)
  }

  Device --> DeviceType
  Device --> DeviceStatus
  NetworkInfo --> ConnectivityType
  DeviceRepository ..> Device
  DeviceService ..> DeviceRepository
}

package "User Permissions (Supporting)" #ddf8dd {
  package "User Aggregate" {
    class User <<Aggregate Root>> {
      userId: UUID
      username: String
      email: Email
      role: UserRole
      accountStatus: AccountStatus
      permissions: List<Permission>
    }

    class Email <<Value Object>> {
      value: String
    }

    class Permission <<Value Object>> {
      deviceId: UUID
      accessLevel: AccessLevel
    }

    enum UserRole {
      OWNER
      ADMIN
      MEMBER
      GUEST
    }

    enum AccountStatus {
      ACTIVE
      SUSPENDED
    }

    enum AccessLevel {
      READ_ONLY
      CONTROL
      FULL_ACCESS
    }
  }

  interface UserRepository <<Repository>> {
    findByUserId(userId)
    findByUsername(username)
    findByEmail_Value(email)
    findAll()
    save(User)
    delete(User)
  }

  interface UserService <<Domain Service>> {
    getAllUsers()
    getUserById(userId)
    createUser(dto)
    updateUser(userId, dto)
    deleteUser(userId)
  }

  class UserServiceImpl <<Domain Service>>

  User *-- Email
  User *-- "0..*" Permission
  User --> UserRole
  User --> AccountStatus
  Permission --> AccessLevel
  UserRepository ..> User
  UserServiceImpl ..|> UserService
  UserServiceImpl ..> UserRepository
}

note left of Scene
  Invariant:
  Scene must contain at least one
  TriggerRule and one DeviceAction
  before it can be activated.
end note

note top of SceneOrchestration
  Invariant:
  SceneOrchestration must contain at least one
  ManagedDeviceAction and one ManagedTriggerRule.
  Owner must be ACTIVE and have CONTROL/FULL_ACCESS
  to every referenced device. Each device must be
  ONLINE and have a nonblank firmwareVersion.
end note

note right of Device
  Invariant:
  Device name must be unique.
  The implemented aggregate currently persists
  capabilities as List<String> and connectivityType
  as String.
end note

note bottom of DeviceCapabilities
  These embeddable value objects exist in the
  device-service domain package, but are not
  currently attached to Device.
end note

note left of User
  Invariant:
  Username must be unique.
  A user needs CONTROL or FULL_ACCESS permission
  to control a device through a scene orchestration.
end note

note bottom of ApiGateway
  The gateway owns controllers, DTOs, and service clients only.
  It does not define a separate domain aggregate.
end note

ApiGateway ..> DeviceService
ApiGateway ..> UserService
ApiGateway ..> SceneService
ApiGateway ..> TriggerRuleService
ApiGateway ..> SceneOrchestrationService

DeviceAction ..> Device : deviceId
Permission ..> Device : deviceId
ManagedDeviceAction ..> Device : deviceId
ManagedTriggerRule ..> TriggerRule : triggerId
SceneOrchestration ..> User : ownerUserId
SceneOrchestration ..> Scene : automationSceneId

@enduml
