@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram for SmartHome Web Service

' Actors / Users
Person(user, "SmartHome User", "A user (Admin, Member, or Guest) who monitors and manages the smart home environment.")

' The System being described
System(smarthome, "SmartHome Web Service", "Allows users to manage smart home devices, firmware, automation routines (scenes/triggers), and user permissions.")

' External Systems
System_Ext(smart_devices, "Smart Devices", "Physical smart home hardware (e.g., cameras, lights, thermostats, locks, and sensors) deployed in the environment.")

' Relationships
Rel(user, smarthome, "Manages devices, configures automation scenes, and updates firmware via", "REST/HTTP")
Rel(smarthome, smart_devices, "Sends action commands and firmware updates to", "Network Protocols")
Rel(smart_devices, smarthome, "Reports sensor data and status updates to", "Network Protocols")

@enduml