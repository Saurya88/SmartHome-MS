@startuml
title Smart Home Management Platform - DDD Domain Model

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam package {
  BorderColor #555555
  FontStyle bold
}

skinparam class {
  BorderColor #666666
  BackgroundColor #f8f8f8
}

legend right
  <b>DDD Legend</b>
  <<Aggregate Root>> Aggregate Root
  <<Entity>> Entity
  <<Value Object>> Value Object
  <<Repository>> Repository
  <<Domain Service>> Domain Service
  --> Reference by ID
  *-- Owned inside aggregate
  Red context: Core Subdomain
  Blue/Green contexts: Supporting Subdomains
  Grey context: Out of Scope
endlegend

package "Scene Orchestration (CORE)" #ffd6d6 {
  package "Scene Orchestration Aggregate" {
    class SceneOrchestration <<Aggregate Root>> {
      orchestrationId: UUID
      ownerUserId: UUID
      automationSceneId: UUID
      name: String
      status: SceneOrchestrationStatus
      createdAt: DateTime
    }

    class ManagedDeviceAction <<Value Object>> {
      deviceId: UUID
      actionType: String
      parameters: String
    }

    class ManagedTriggerRule <<Value Object>> {
      triggerId: String
      triggerType: String
      conditionExpression: String
      enabled: Boolean
      triggerValue: String
    }

    enum SceneOrchestrationStatus {
      ACTIVE
      INACTIVE
      SCHEDULED
    }
  }

  interface SceneOrchestrationRepository <<Repository>> {
    findById(orchestrationId)
    findAll()
    save(sceneOrchestration)
  }

  class SceneOrchestrationService <<Domain Service>> {
    createSceneOrchestration()
    updateSceneOrchestration()
    deleteSceneOrchestration()
    validateOwnerAndDevices()
  }

  SceneOrchestration *-- "1..*" ManagedDeviceAction
  SceneOrchestration *-- "1..*" ManagedTriggerRule
  SceneOrchestration --> SceneOrchestrationStatus
  SceneOrchestrationRepository ..> SceneOrchestration
  SceneOrchestrationService ..> SceneOrchestrationRepository
}

package "Automation Routine Management (Supporting)" #dcecff {
  package "Scene Aggregate" {
    class Scene <<Aggregate Root>> {
      sceneId: UUID
      name: String
      status: SceneStatus
      createdAt: DateTime
      activate()
    }

    class DeviceAction <<Value Object>> {
      deviceId: UUID
      actionType: String
      parameters: String
    }

    enum SceneStatus {
      ACTIVE
      INACTIVE
      SCHEDULED
    }
  }

  package "Trigger Rule Aggregate" {
    class TriggerRule <<Aggregate Root>> {
      triggerId: String
      triggerType: TriggerType
      conditionExpression: String
      enabled: Boolean
      triggerValue: String
    }

    class Condition <<Value Object>> {
      attribute: String
      operator: String
      conditionValue: String
    }

    class Schedule <<Value Object>> {
      startTime: DateTime
      endTime: DateTime
      recurrencePattern: String
    }

    enum TriggerType {
      TIME_BASED
      SENSOR_EVENT
      MANUAL
    }
  }

  interface SceneRepository <<Repository>> {
    findById(sceneId)
    findAll()
    save(scene)
  }

  interface TriggerRuleRepository <<Repository>> {
    findById(triggerId)
    findAll()
    save(triggerRule)
  }

  class SceneService <<Domain Service>> {
    createScene()
    updateScene()
    replaceDeviceActions()
    replaceTriggerRules()
    activateScene()
  }

  class TriggerRuleService <<Domain Service>> {
    createTriggerRule()
    updateTriggerRule()
    deleteTriggerRule()
  }

  Scene *-- "0..*" DeviceAction
  Scene *-- "0..*" TriggerRule
  Scene --> SceneStatus
  TriggerRule *-- Condition
  TriggerRule *-- Schedule
  TriggerRule --> TriggerType
  SceneRepository ..> Scene
  TriggerRuleRepository ..> TriggerRule
  SceneService ..> SceneRepository
  TriggerRuleService ..> TriggerRuleRepository
}

package "Device Registry (Supporting)" #dcecff {
  package "Device Aggregate" {
    class Device <<Aggregate Root>> {
      deviceId: UUID
      deviceName: String
      deviceType: DeviceType
      status: DeviceStatus
      firmwareVersion: String
      registeredAt: DateTime
      connectivityType: String
    }

    class DeviceCapability <<Value Object>> {
      capability: String
    }

    enum DeviceType {
      LIGHT
      THERMOSTAT
      SENSOR
      CAMERA
      LOCK
    }

    enum DeviceStatus {
      ONLINE
      OFFLINE
      MAINTENANCE
    }
  }

  interface DeviceRepository <<Repository>> {
    findById(deviceId)
    existsByDeviceName(deviceName)
    save(device)
  }

  class DeviceService <<Domain Service>> {
    createDevice()
    updateDevice()
    deleteDevice()
  }

  Device *-- "0..*" DeviceCapability
  Device --> DeviceType
  Device --> DeviceStatus
  DeviceRepository ..> Device
  DeviceService ..> DeviceRepository
}

package "User Permissions (Supporting)" #ddf8dd {
  package "User Aggregate" {
    class User <<Aggregate Root>> {
      userId: UUID
      username: String
      email: Email
      role: UserRole
      accountStatus: AccountStatus
    }

    class Email <<Value Object>> {
      value: String
    }

    class Permission <<Value Object>> {
      deviceId: UUID
      accessLevel: AccessLevel
    }

    enum UserRole {
      OWNER
      ADMIN
      MEMBER
      GUEST
    }

    enum AccountStatus {
      ACTIVE
      SUSPENDED
    }

    enum AccessLevel {
      READ_ONLY
      CONTROL
      FULL_ACCESS
    }
  }

  interface UserRepository <<Repository>> {
    findByUserId(userId)
    findByUsername(username)
    save(user)
  }

  class UserService <<Domain Service>> {
    createUser()
    updateUser()
    deleteUser()
  }

  User *-- Email
  User *-- "0..*" Permission
  User --> UserRole
  User --> AccountStatus
  Permission --> AccessLevel
  UserRepository ..> User
  UserService ..> UserRepository
}

package "Firmware Update Management (Out of Scope)" #dddddd {
  class Firmware <<Aggregate Root>> {
    firmwareId: UUID
    version: String
    compatibleDeviceType: DeviceType
    mandatory: Boolean
  }
}

note left of SceneOrchestration
  Aggregate Invariant:
  A scene orchestration must contain at least
  one ManagedTriggerRule and one ManagedDeviceAction.
  The owner user must be ACTIVE and have CONTROL
  or FULL_ACCESS to every referenced device.
  Every referenced device must be ONLINE and
  have a valid firmwareVersion.
end note

note left of Scene
  Low-level Invariant:
  A Scene must contain at least one
  TriggerRule and one DeviceAction
  before it can be activated.
end note

note right of Firmware
  Out of Scope:
  Dedicated firmware management was proposed,
  but Milestone 2 keeps compatibility checks
  at the orchestration layer and stores the
  current firmwareVersion on Device.
end note

ManagedDeviceAction ..> Device : deviceId
Permission ..> Device : deviceId
SceneOrchestration ..> User : ownerUserId
SceneOrchestration ..> Scene : automationSceneId
Scene ..> TriggerRule : uses in automation runtime

@enduml
